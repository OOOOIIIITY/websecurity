# Wazuh Environment Configuration
# Copy this file to .env and update with your own values

# Wazuh Version
WAZUH_VERSION=4.7.0

# ⚠️ SECURITY: Change these default passwords!
# These are the default passwords from Wazuh documentation
# YOU MUST change them for production deployments

# Indexer credentials
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword

# Wazuh API credentials
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# Dashboard credentials
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver

# Java heap size for indexer (adjust based on available RAM)
INDEXER_JAVA_OPTS=-Xms1g -Xmx1g

# Notes:
# - For production, use strong passwords (min 16 chars, mixed case, numbers, symbols)
# - Store this file securely and never commit it to version control
# - Consider using Docker secrets for more secure credential management
